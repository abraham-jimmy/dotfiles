[
  {
    "name": "RightMon",
    "layer": "top",
    "height": 24,
    "spacing": 4,
    "output": "ASUSTek COMPUTER INC VG27B K7LMQS089435",

    "modules-left": [
      "custom/workspace-state",
      "custom/middle-workspace-1",
      "custom/middle-workspace-2",
      "custom/middle-workspace-3",
      "custom/spotify"
    ],
    "modules-center": [
      "custom/right-workspace-4",
      "custom/right-workspace-5",
      "custom/right-workspace-6",
      "custom/right-workspace-7",
      "custom/right-workspace-8",
      "custom/right-workspace-9",
      "custom/right-workspace-10"
    ],
    "modules-right": [
      "wlr/taskbar",
      "tray",
      "clock",
      "wireplumber",
      "custom/power"
    ],

    "custom/middle-workspace-1": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 1",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 1",
      "tooltip": true
    },

    "custom/middle-workspace-2": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 2",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 2",
      "tooltip": true
    },

    "custom/middle-workspace-3": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 3",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 3",
      "tooltip": true
    },

    "custom/workspace-state": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh watch",
      "return-type": "json",
      "restart-interval": 1,
      "tooltip": false
    },

    "custom/right-workspace-4": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 4",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 4"
    },

    "custom/right-workspace-5": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 5",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 5"
    },

    "custom/right-workspace-6": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 6",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 6"
    },

    "custom/right-workspace-7": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 7",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 7"
    },

    "custom/right-workspace-8": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 8",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 8"
    },

    "custom/right-workspace-9": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 9",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 9"
    },

    "custom/right-workspace-10": {
      "exec": "bash ~/.config/waybar/modules/workspace-state.sh stream 10",
      "return-type": "json",
      "restart-interval": 1,
      "exec-on-event": false,
      "on-click": "hyprctl dispatch workspace 10"
    },

    "custom/spotify": {
      "exec": "/usr/bin/python3 ~/.config/waybar/mediaplayer.py --player spotify",
      "format": "{}  ",
      "return-type": "json",
      "max-length": 45,
      "on-click": "playerctl --player=spotify play-pause",
      "on-scroll-up": "playerctl --player=spotify next",
      "on-scroll-down": "playerctl --player=spotify previous"
    },

    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 18,
      "all-outputs": true,
      "active-first": true,
      "tooltip-format": "{name}: {title}",
      "on-click": "activate",
      "on-click-middle": "close"
    },

    "tray": {
      "spacing": 6
    },

    "clock": {
      "format": "{:%a, %d %b  %H:%M}",
      "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "days": "<span color='#ecc6d9'><b>{}</b></span>",
          "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-click-forward": "tz_up",
        "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },

    "wireplumber": {
      "format": "{volume}% {icon}",
      "format-muted": "Muted ",
      "on-click": "pavucontrol",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "format-icons": ["", "", ""]
    },

    "custom/power": {
      "format": "󰐥",
      "tooltip": true,
      "tooltip-format": "Power menu",
      "on-click": "bash ~/.config/waybar/modules/power-menu.sh"
    }
  }
]
